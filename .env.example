# ─────────────────────────────────────────────────────────────
# Ecocan — Environment Variable Reference
# Copy this file to .env.local for local development.
# .env.local is git-ignored; never commit real values.
# ─────────────────────────────────────────────────────────────

# ── App identity ─────────────────────────────────────────────
# Canonical URL for Open Graph / sitemap / canonical links.
# Set this to your Vercel deployment URL or custom domain.
NEXT_PUBLIC_APP_URL=https://ecocan.africa

# Human-readable site name used in meta tags and OG cards.
NEXT_PUBLIC_SITE_NAME=ECOCAN

# ── Vercel (set automatically by the Vercel platform) ────────
# Do not set these manually — Vercel injects them at build time.
# NEXT_PUBLIC_VERCEL_ENV=production

# ── Future variables (add here when implemented) ─────────────
# Contact form email / webhook:
# CONTACT_FORM_ENDPOINT=
# CONTACT_FORM_API_KEY=

# Analytics:
# NEXT_PUBLIC_GA_ID=
